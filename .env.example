# Copier ce fichier en .env.local puis remplir les valeurs.

# Adresse publique du site, sans « / » final
NEXT_PUBLIC_SITE_URL=https://liggeey.sn

# Plateforme LIGGEEY (connexion, inscription, offres).
# /plateforme = prototype intégré au site. Mettre l'adresse de l'app quand elle sera déployée à part.
NEXT_PUBLIC_APP_URL=/plateforme

# API de l'application qui fournit les offres en vitrine (laisser vide si pas encore prête)
APP_API_URL=

# Afficher des offres d'exemple tant que l'API n'est pas branchée (true / false)
# Mettre à false avant la mise en ligne.
NEXT_PUBLIC_DEMO_OFFRES=true

# Adresse qui reçoit les formulaires (Make, Zapier, Google Apps Script, CRM…)
FORM_WEBHOOK_URL=

# Liens de paiement marchand pour l'inscription au Job Dating
NEXT_PUBLIC_WAVE_PAYMENT_URL=
NEXT_PUBLIC_OM_PAYMENT_URL=

# Base de données PostgreSQL de la plateforme (Neon, Supabase, serveur dédié…).
# Vide en développement : une base intégrée (PGlite) est créée dans .donnees/pglite.
# Obligatoire en production. Après chaque mise en ligne : npm run db:migrer
DATABASE_URL=

# Écran de connexion : proposer les comptes de démonstration (npm run db:amorcer).
# Mettre à false avant la mise en ligne.
NEXT_PUBLIC_COMPTES_DEMO=true
